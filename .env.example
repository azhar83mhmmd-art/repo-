# RepoFast does NOT need any secret to run.
# GitHub tokens are entered by the user, kept on the user's device only,
# and forwarded per request. Nothing is stored on the server.

# Optional: restrict which browser origins may call the API (comma separated).
# Leave empty to allow same-origin only (recommended on Vercel).
# ALLOWED_ORIGINS=https://repofast.vercel.app

# Optional: override the GitHub API base URL (GitHub Enterprise or local mock tests).
# GITHUB_API_URL=https://api.github.com

# Optional: per-IP requests allowed per minute per function instance (default 240).
# RATE_LIMIT_PER_MIN=240
